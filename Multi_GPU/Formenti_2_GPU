####################
### MY CONSTANTS ###
####################
my_constants.GeV   = q_e*1.e9
my_constants.pico  = 1.e-12
my_constants.nano  = 1.e-9
my_constants.micro = 1.e-6
my_constants.milli = 1.e-3

warpx.self_fields_verbosity = 0
beam1.self_fields_verbosity = 0
beam2.self_fields_verbosity = 0
collisions.split_momentum_push = 0
